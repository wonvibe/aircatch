# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Travelpayouts Data API (price data source — Amadeus Self-Service was
# decommissioned 2026-07-17) ---
TRAVELPAYOUTS_TOKEN=

# --- Expo Push ---
