# Expo only inlines EXPO_PUBLIC_* vars, and only reads .env files from this
# app's own root — copy this to apps/mobile/.env (values match the root
# .env's EXPO_PUBLIC_* entries; see ../../.env.example).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
